# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_TZ=America/New_York
NEXT_PUBLIC_BUSINESS_NAME=Sparkle Home Cleaning
NEXT_PUBLIC_CURRENCY=USD
# Shared secret for /api/cron/* (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# --- Google Calendar (OAuth refresh token of the business owner's account) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Notifications (all optional; unset channels fall back to WhatsApp deep links) ---
ADMIN_EMAIL=
ADMIN_WHATSAPP=+15551234567
RESEND_API_KEY=
RESEND_FROM="Sparkle Home Cleaning <noreply@yourdomain.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550001111
# WhatsApp Cloud API (Meta). Business-initiated messages require approved templates.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
